{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@resumeai/shared": ["./packages/shared/src/index.ts"],
      "@resumeai/database": ["./packages/database/src/index.ts"],
      "@resumeai/config": ["./packages/config/src/index.ts"]
    }
  },
  "include": ["src/**/*", "api/**/*", "packages/**/*"],
  "exclude": ["tests/**/*", "node_modules", "dist"]
}

