# ==============================================================================
# ResumeAI Backend — Environment Configuration Template (.env.example)
#
# Copy this file to .env for local development: cp .env.example .env
# Set these environment variables in your Vercel Project Settings for production.
# NEVER commit real credentials or production secrets to Git.
# ==============================================================================

# Server Configuration
NODE_ENV="development" # "development" | "production" | "test"
PORT=4000
API_PORT=4000
API_HOST="127.0.0.1"
API_CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Database (Neon PostgreSQL + Prisma)
# DATABASE_URL: Pooled connection string (PgBouncer) for runtime queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string for migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cache & Background Jobs (Redis / Upstash)
REDIS_URL="redis://localhost:6379"

# AI Configuration (Groq / OpenAI)
AI_PROVIDER="groq" # "groq" | "openai" | "mock"
GROQ_API_KEY="gsk_placeholder_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"
AI_DEFAULT_MODEL="openai/gpt-oss-120b"
AI_FAST_MODEL="openai/gpt-oss-120b"
AI_USE_MOCK="false"
OPENAI_API_KEY="sk-placeholder"

# Authentication & Security
JWT_SECRET="development-jwt-secret-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="development-cookie-secret-key-min-32-chars-long"
COOKIE_SAME_SITE="lax"

# PDF Rendering Engine ("playwright" | "puppeteer")
PDF_RENDERER="playwright"

# Object Storage ("local" | "s3")
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="resumeai-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""
