{
  "name": "resume-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:packages": "node scripts/build-packages.js",
    "build": "npm run build:packages && prisma generate --schema=./packages/database/prisma/schema.prisma && tsc && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/src/server.js && esbuild src/serverless.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "postinstall": "npm run build:packages && prisma generate --schema=./packages/database/prisma/schema.prisma",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema=./packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=./packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@prisma/client": "^6.4.1",
    "@resumeai/config": "*",
    "@resumeai/database": "*",
    "@resumeai/shared": "*",
    "@sparticuz/chromium": "^153.0.0",
    "@whop/sdk": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "openai": "^4.85.4",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
